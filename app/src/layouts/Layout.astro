---
// Fonts are self-hosted with our own @font-face (font-display: block) in
// global.css, and preloaded below — so the real font shows immediately with no
// fallback flash / weight jump.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import AskAI from '../components/AskAI.astro';
import { SITE, PERSON_ID, ORG_ID, WEBSITE_ID } from '../lib/entity';

interface Props {
  title?: string;
  description?: string;
  // Absolute URL for og:image / twitter:image (product pages pass their cover). Optional:
  // without it every page keeps the site logo, exactly as before.
  image?: string;
}

// Title order = homepage section order (v2, 2026-10-08: Code · Motion · Visual).
const {
  title = 'zosc — Code · Motion · Visual',
  description = 'zosc — a motion designer, visual artist & developer. Living interactive interfaces, motion, and visual art; proficient in After Effects, Cinema 4D, Octane.',
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = image ?? new URL('/media/images/common/brand/cropped-logo_high2.png', SITE).href;
// The five profiles. Both the Person and the Organization claim them (v3 decision): the handles
// are the zosc brand's accounts.
const sameAs = [
  'https://github.com/byzosc',
  'https://x.com/byzosc',
  'https://www.behance.net/zosc',
  'https://steamcommunity.com/id/byzosc',
  'https://blog.zosc.com/',
];
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': PERSON_ID,
  name: 'zosc',
  alternateName: ['byzosc', 'zosc lion', 'ZERB', 'ZERB LION', 'zerbLion'],  // 'zosc lion' = Behance 显示名（姓氏必填），列在这里 Google 才认得出那个档案
  url: SITE,
  jobTitle: 'Motion Designer, Visual Artist & Developer',
  // Back to the Organization below by @id — one entity, referenced, never a second copy.
  worksFor: { '@id': ORG_ID },
  affiliation: { '@id': ORG_ID },
  sameAs,
};
// v3 (2026-10-08): zosc is also the label the products ship under (出品人 — not a company, not a
// lab). founder ties it to the Person; product pages name it as SoftwareApplication publisher.
// logo: the 192 px Z mark (square, above Google's 112 px minimum for an organization logo).
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'zosc',
  url: SITE,
  logo: `${SITE}/media/images/common/brand/zosc-mark-192.png`,
  founder: { '@id': PERSON_ID },
  sameAs,
};
// WebSite schema — tells Google the site name to show in search results.
// Long-game target: own the query "zosc" itself. No competing entity holds it —
// only unrelated Open Sound Control docs — so zosc leads the alternate names.
// ZERB / ZERB LION stay listed so Google links the old identity to this one.
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  name: 'zosc',
  alternateName: ['byzosc', 'ZERB', 'ZERB LION'],
  url: SITE,
  publisher: { '@id': ORG_ID },
};

// Favicon <link>s in <head>. This note lives here, not in the markup: HTML comments ship in
// every page, and this one names the old file names.
// 顺序有意：大图标在前。Google 文档要求图标为正方形、至少 8x8，并建议 >48px；
// 原来第一条是 32x32，低于建议值。Google 支持 BMP/GIF/ICO/PNG/JPEG/PPM/TIFF，
// 不含 SVG，且明确说明「不会自动回退去取 /favicon.ico」——必须在首页显式声明，
// 所以 ico 这条不能省。svg 只给浏览器用，对 Google 无效。
// https://developers.google.com/search/docs/appearance/favicon-in-search
//
// 文件名为什么从 zosc-favicon-* 改成 zosc-mark-*（2026-10-08）：
// Google 的站点图标缓存是**按 URL** 存的。2026-10-06 那次品牌替换把引用改成了
// zosc-favicon-*.png 但文件还叫 zerb-favicon-*.png，三个图标全 404；Googlebot 正好
// 在那个窗口第一次抓 zosc.com，回退取了当时还是 Astro 默认 logo 的 /favicon.svg 并存下。
// 旧 URL 上已经绑定了错误结果，换成从未被抓过的新路径才能强制重取。
// 旧文件保留，不删（可能有外部引用）。
---

<!doctype html>
<html lang="en">
  <head>
    <!--
      zosc — Code · Motion · Visual  ·  https://zosc.com
      © 2026 zosc. All rights reserved — code and creative work.
      Source-available for reference, NOT open source. Don't copy or republish.
      Designed, written & built by zosc — https://github.com/byzosc
    -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Gate the hero intro: hide intro elements only when JS is present, and
      // force-reveal after a timeout as a failsafe so the headline can NEVER get
      // stuck invisible if the intro script fails to run.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        // Always start at the top on (re)load so the header's scrolled-state border
        // never flashes on during scroll restoration.
        try { history.scrollRestoration = 'manual'; } catch (e) {}
        // Only force-reveal if the intro actually failed to finish — otherwise the
        // failsafe's !important rules would keep overriding the live cursor-magnet.
        setTimeout(function () {
          if (!d.classList.contains('intro-ready')) d.classList.add('hero-fallback');
        }, 3500);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="zosc" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="zosc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    <link rel="icon" href="/media/images/common/brand/zosc-mark-192.png" sizes="192x192" />
    <link rel="icon" href="/media/images/common/brand/zosc-mark-32.png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/media/images/common/brand/zosc-mark-180.png" />
    <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/mulish-latin.woff2" as="font" type="font/woff2" crossorigin />
    <noscript>
      <style>.reveal { opacity: 1 !important; transform: none !important; }</style>
    </noscript>
    <Analytics />
    <ClientRouter />
  </head>
  <body class="bg-ink text-paper">
    <div id="cursor" transition:persist="cursor" aria-hidden="true"><span class="cursor-label"></span></div>
    <Header />
    <slot />
    <AskAI transition:persist="askai" />

    <script>
      import { setupMotion } from '../scripts/motion';
      setupMotion();
    </script>
  </body>
</html>
