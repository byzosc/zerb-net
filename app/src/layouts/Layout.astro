---
// Fonts are self-hosted with our own @font-face (font-display: block) in
// global.css, and preloaded below — so the real font shows immediately with no
// fallback flash / weight jump.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import AskAI from '../components/AskAI.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ZOSC — Motion · Visual · Code',
  description = 'ZOSC (ZOSC) — a motion designer, visual artist & developer. Motion, visual art, and living interactive interfaces; proficient in After Effects, Cinema 4D, Octane.',
} = Astro.props;

const SITE = 'https://zosc.com';
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL('/media/images/common/brand/cropped-logo_high2.png', SITE).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'ZOSC',
  alternateName: ['byZOSC', 'ZERB', 'ZERB LION', 'zerbLion'],
  url: SITE,
  jobTitle: 'Motion Designer, Visual Artist & Developer',
  sameAs: [
    'https://github.com/byzosc',
    'https://x.com/byzosc',
    'https://www.behance.net/zosc',
    'https://steamcommunity.com/id/zerblion',
    'https://blog.zosc.com/',
  ],
};
// WebSite schema — tells Google the site name to show in search results.
// Long-game target: own the query "ZOSC" itself. No competing entity holds it —
// only unrelated Open Sound Control docs — so ZOSC leads the alternate names.
// ZERB / ZERB LION stay listed so Google links the old identity to this one.
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ZOSC',
  alternateName: ['byZOSC', 'ZERB', 'ZERB LION'],
  url: SITE,
};
---

<!doctype html>
<html lang="en">
  <head>
    <!--
      ZOSC — Motion · Visual · Code  ·  https://zosc.com
      © 2026 ZOSC. All rights reserved — code and creative work.
      Source-available for reference, NOT open source. Don't copy or republish.
      Designed, written & built by ZOSC — https://github.com/byzosc
    -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Gate the hero intro: hide intro elements only when JS is present, and
      // force-reveal after a timeout as a failsafe so the headline can NEVER get
      // stuck invisible if the intro script fails to run.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        // Always start at the top on (re)load so the header's scrolled-state border
        // never flashes on during scroll restoration.
        try { history.scrollRestoration = 'manual'; } catch (e) {}
        // Only force-reveal if the intro actually failed to finish — otherwise the
        // failsafe's !important rules would keep overriding the live cursor-magnet.
        setTimeout(function () {
          if (!d.classList.contains('intro-ready')) d.classList.add('hero-fallback');
        }, 3500);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="ZOSC (ZOSC)" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZOSC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    <link rel="icon" href="/media/images/common/brand/zosc-favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/media/images/common/brand/zosc-favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/media/images/common/brand/zosc-favicon-180.png" />
    <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/mulish-latin.woff2" as="font" type="font/woff2" crossorigin />
    <noscript>
      <style>.reveal { opacity: 1 !important; transform: none !important; }</style>
    </noscript>
    <Analytics />
    <ClientRouter />
  </head>
  <body class="bg-ink text-paper">
    <div id="cursor" transition:persist="cursor" aria-hidden="true"><span class="cursor-label"></span></div>
    <Header />
    <slot />
    <AskAI transition:persist="askai" />

    <script>
      import { setupMotion } from '../scripts/motion';
      setupMotion();
    </script>
  </body>
</html>
