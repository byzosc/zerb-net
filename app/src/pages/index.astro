---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';

const all = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// Cards always go to the internal case page; external product links live
// there as a CTA button.
const hrefFor = (p: (typeof all)[number]) => `/project/${p.id}/`;

// v2 (2026-10-08): Code leads — the differentiator is motion systems turned into shipped tools.
// Section names and anchor ids (#code / #motion / #visual) are unchanged; only the order moved.
// Which cards a section shows:
//   featuredOnly: true  → only entries with `featured: true` (Code: the 3–4 flagship products;
//                         every other product lives on /works and its own page)
//   featuredOnly: false → the first 5 by `order` (Motion, Visual — same rule as before v2)
// Either way the first card is the large one and at most 5 are shown, so the section rhythm
// (one large card + a two-column grid) stays the same.
const pillars = [
  { id: 'code', label: 'Code', tagline: 'Things built, not just designed.', featuredOnly: true },
  { id: 'motion', label: 'Motion', tagline: 'Systems of movement — interfaces that breathe.', featuredOnly: false },
  { id: 'visual', label: 'Visual', tagline: 'Worlds, surfaces and light.', featuredOnly: false },
] as const;
const MAX_CARDS = 5;

const byPillar = (id: string) => all.filter((p) => p.data.pillars.includes(id as any));
const cardsFor = (pillar: (typeof pillars)[number]) => {
  const inPillar = byPillar(pillar.id);
  return (pillar.featuredOnly ? inPillar.filter((p) => p.data.featured) : inPillar).slice(0, MAX_CARDS);
};
---

<Layout>

  <main>
    <!-- HERO -->
    <section class="relative flex min-h-screen flex-col justify-center px-6 md:px-10">
      <div class="mx-auto w-full max-w-[1400px]" data-hero>
        <h1 class="font-display text-[14vw] font-black leading-[0.85] md:text-[10vw]">
          <span class="hl"><span class="hl-t" data-mask>Motion</span><span class="hero-dot" data-dot="motion" aria-hidden="true"><span class="hero-dot-m"><i class="hero-dot-i"></i></span></span></span><br />
          <span class="hl"><span class="hl-t" data-blur>Visual</span><span class="hero-dot" data-dot="visual" aria-hidden="true"><span class="hero-dot-m"><i class="hero-dot-i"></i></span></span></span><br />
          <span class="hl"><span class="hl-t" data-type>Code</span><span class="hero-dot" data-dot="code" aria-hidden="true"><span class="hero-dot-m"><i class="hero-dot-i"></i></span></span></span>
        </h1>
        <p class="mt-8 max-w-xl text-lg text-mist">
          zosc is a motion designer, visual artist & creative developer. Ask the AI anything.
        </p>
      </div>
      <div class="absolute bottom-8 left-6 flex items-center gap-3 text-xs uppercase tracking-[0.25em] text-mist md:left-10">
        <span class="relative block h-10 w-px overflow-hidden bg-line">
          <span class="absolute inset-x-0 top-0 h-4 animate-[scrollcue_1.8s_ease-in-out_infinite] bg-accent"></span>
        </span>
        Scroll
      </div>
    </section>

    <!-- PILLAR SECTIONS -->
    {
      pillars.map((pillar) => {
        const [featured, ...rest] = cardsFor(pillar); // large card + up to 4
        return (
          <section id={pillar.id} class="border-t border-line px-6 py-28 md:px-10 md:py-40">
            <div class="mx-auto max-w-[1400px]">
              <div class="reveal mb-16 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
                <h2 class="font-display text-6xl font-black md:text-8xl">{pillar.label}</h2>
                <p class="text-mist md:text-right">{pillar.tagline}</p>
              </div>
              {
                featured ? (
                  <div class="space-y-16">
                    <ProjectCard
                      featured
                      href={hrefFor(featured)}
                      title={featured.data.title}
                      cover={featured.data.coverLarge ?? featured.data.cover}
                      year={featured.data.year}
                    />
                    {rest.length > 0 && (
                      <div class="grid grid-cols-1 gap-x-10 gap-y-16 lg:grid-cols-2">
                        {rest.map((p) => (
                          <ProjectCard
                            href={hrefFor(p)}
                            title={p.data.title}
                            cover={p.data.cover}
                            year={p.data.year}
                          />
                        ))}
                      </div>
                    )}
                  </div>
                ) : (
                  <p class="reveal text-mist">More coming soon.</p>
                )
              }
              {featured && (
                <a
                  href={`/works/?f=${pillar.id}`}
                  data-cursor="View"
                  class="reveal group mt-16 inline-flex items-center gap-3 font-display text-lg font-bold transition-colors hover:text-accent"
                >
                  View all work
                  <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                </a>
              )}
            </div>
          </section>
        );
      })
    }

    <!-- Inline Ask AI prompt — opens the same side panel via [data-ask-ai] -->
    <section class="border-t border-line px-6 py-28 md:px-10 md:py-40">
      <div class="mx-auto max-w-[1400px]">
        <div class="reveal mb-10">
          <h2 class="font-display text-5xl font-black md:text-7xl">AI Ask</h2>
          <p class="mt-4 max-w-xl text-mist">
            Curious about a project, the process, or working together? Ask the AI — it knows the work.
          </p>
        </div>
        <button
          data-ask-ai
          data-cursor="Ask"
          class="reveal group flex w-full max-w-2xl items-center justify-between gap-4 rounded-full border border-line bg-surface px-6 py-4 text-left transition-colors hover:border-accent"
        >
          <span class="text-base text-mist md:text-lg">Ask me anything…</span>
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-paper font-display text-lg text-ink transition-transform duration-300 group-hover:translate-x-0.5"
          >
            →
          </span>
        </button>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
