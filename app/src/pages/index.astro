---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';

const all = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// Cards always go to the internal case page; external product links live
// there as a CTA button.
const hrefFor = (p: (typeof all)[number]) => `/project/${p.id}/`;

// v2 (2026-10-08): Code leads — the differentiator is motion systems turned into shipped tools.
// Section names and anchor ids (#code / #motion / #visual) are unchanged; only the order moved.
// Which cards a section shows:
//   featuredOnly: true  → only entries with `featured: true` (Code: the 3–4 flagship products;
//                         every other product lives on /works and its own page)
//   featuredOnly: false → the first `max` by `order` (Motion, Visual)
// 2026-10-08 (user): every section shows 3 — one large card + one two-column row. The remaining
// Visual entries only live on /works; "后两个没啥意思" on the homepage.
// Either way the first card is the large one, so the section rhythm stays the same.
const pillars = [
  { id: 'code', label: 'Code', tagline: 'Things built, not just designed.', featuredOnly: true },
  { id: 'motion', label: 'Motion', tagline: 'Systems of movement — interfaces that breathe.', featuredOnly: false },
  { id: 'visual', label: 'Visual', tagline: 'Worlds, surfaces and light.', featuredOnly: false },
] as const;
const MAX_CARDS = 3;

const byPillar = (id: string) => all.filter((p) => p.data.pillars.includes(id as any));
const cardsFor = (pillar: (typeof pillars)[number]) => {
  const inPillar = byPillar(pillar.id);
  return (pillar.featuredOnly ? inPillar.filter((p) => p.data.featured) : inPillar).slice(0, MAX_CARDS);
};

// Hero headline stays Motion · Visual · Code on purpose (2026-10-08, user decision), even though
// the sections below lead with Code. The hero is a brand statement, not navigation: its rhythm is
// built on two long words and a short closer — the 4-letter "Code" on the typewriter line is the
// full stop. Putting Code first (4-6-6) lost that cadence, so it was reverted the same day.
// motion.ts animates the three .hl lines by POSITION: line 1 mask wipe ([data-mask] also carries
// the CSS mask), line 2 blur, line 3 typewriter. Each dot's personality follows its word via
// data-dot (global.css; motion.ts repels the "motion" dot).

// ── v3 (2026-10-08): brand first, portfolio second ──────────────────────────────────────────────
// The hero line says what zosc makes and two buttons go straight to the products; a product strip
// sits right under the hero; the three pillar sections follow under a small "Work" label. The
// headline and its intro are untouched. (A "latest from the blog" block was planned too and dropped
// by the user the same day — no gain for the page; the blog stays one link in the header / footer.)

// The line under the headline. One place to change it: the user approved this wording for now and
// may still replace it.
const HERO_TAGLINE = 'Design that runs. Code that moves. Things that ship.';

// Every button below is a direct way to USE a product (its store, or the tool itself), not a case
// study; the small "Details →" link goes to the product page. Each URL must also be one of the
// entry's `links` (checked below), so the homepage can't drift from the product pages.
// Icons: public/media/images/products/<slug>/ (sources in docs/v3/F-REPORT.md).
const PRODUCTS = [
  {
    slug: 'motionpilot',
    icon: '/media/images/products/motionpilot/icon.svg',
    line: 'An After Effects panel that applies your motion spec to keyframes.',
    actions: [{ label: 'Get on Adobe Exchange', url: 'https://exchange.adobe.com/apps/cc/205857' }],
  },
  {
    slug: 'motionrules',
    icon: '/media/images/products/motionrules/icon.svg',
    line: 'Motion design tools that share one motion spec, from definition to Lottie handoff.',
    actions: [{ label: 'Open motionrules.com', url: 'https://motionrules.com/' }],
  },
  {
    slug: 'cubby',
    icon: '/media/images/products/cubby/icon.png',
    line: 'Remember where you put things: note it in one line, find it later.',
    actions: [
      { label: 'App Store', url: 'https://apps.apple.com/app/id6804703410' },
      { label: 'Google Play', url: 'https://play.google.com/store/apps/details?id=com.zerblion.findly' },
    ],
  },
];
const HERO_ACTIONS = [
  { label: 'Get MotionPilot', url: 'https://exchange.adobe.com/apps/cc/205857' },
  { label: 'Open MotionRules', url: 'https://motionrules.com/' },
];
const products = PRODUCTS.map((p) => {
  const entry = all.find((e) => e.id === p.slug);
  if (!entry) throw new Error(`index.astro product strip: no live project entry "${p.slug}"`);
  const known = new Set((entry.data.links ?? []).map((l) => l.url));
  const stray = p.actions.filter((a) => !known.has(a.url));
  if (stray.length) throw new Error(`index.astro: ${stray.map((a) => a.url).join(', ')} not in ${p.slug}.md links`);
  return { ...p, name: entry.data.title };
});
// The hero buttons are shortcuts to product actions above, which are checked against the entries.
const orphan = HERO_ACTIONS.filter((a) => !PRODUCTS.some((p) => p.actions.some((b) => b.url === a.url)));
if (orphan.length) throw new Error(`index.astro: hero action ${orphan.map((a) => a.url).join(', ')} is not a product action`);

// Same pill buttons as the product pages (project/[slug].astro); the first one is the accent one.
// Colour transitions only — nothing clickable moves (AGENTS.md: a moving target can swallow the
// click).
const BTN_PRIMARY =
  'inline-flex items-center gap-2 rounded-full border border-accent px-6 py-3 font-display text-sm font-bold uppercase tracking-wide text-accent transition-colors hover:bg-accent hover:text-ink';
const BTN_SECONDARY =
  'inline-flex items-center gap-2 rounded-full border border-line px-6 py-3 font-display text-sm font-bold uppercase tracking-wide text-paper transition-colors hover:border-accent hover:text-accent';
---

<Layout>

  <main>
    <!-- HERO -->
    <section class="relative flex min-h-screen flex-col justify-center px-6 md:px-10">
      <div class="mx-auto w-full max-w-[1400px]" data-hero>
        <h1 class="font-display text-[14vw] font-black leading-[0.85] md:text-[10vw]">
          <span class="hl"><span class="hl-t" data-mask>Motion</span><span class="hero-dot" data-dot="motion" aria-hidden="true"><span class="hero-dot-m"><i class="hero-dot-i"></i></span></span></span><br />
          <span class="hl"><span class="hl-t" data-blur>Visual</span><span class="hero-dot" data-dot="visual" aria-hidden="true"><span class="hero-dot-m"><i class="hero-dot-i"></i></span></span></span><br />
          <span class="hl"><span class="hl-t" data-type>Code</span><span class="hero-dot" data-dot="code" aria-hidden="true"><span class="hero-dot-m"><i class="hero-dot-i"></i></span></span></span>
        </h1>
        <p class="mt-8 max-w-xl text-lg text-mist">{HERO_TAGLINE}</p>
        <div data-hero-cta class="mt-8 flex flex-wrap gap-3">
          {
            HERO_ACTIONS.map((a, i) => (
              <a href={a.url} target="_blank" rel="noopener noreferrer" data-cursor="Open" class={i === 0 ? BTN_PRIMARY : BTN_SECONDARY}>
                {a.label} <span aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>
      <div class="absolute bottom-8 left-6 flex items-center gap-3 text-xs uppercase tracking-[0.25em] text-mist md:left-10">
        <span class="relative block h-10 w-px overflow-hidden bg-line">
          <span class="absolute inset-x-0 top-0 h-4 animate-[scrollcue_1.8s_ease-in-out_infinite] bg-accent"></span>
        </span>
        Scroll
      </div>
    </section>

    <!-- PRODUCTS -->
    <section id="products" class="pt-10">
      {/* label over a full-width rule — the same shape as "Work" over the #code border below */}
      <div class="px-6 pb-6 md:px-10">
        <p class="mx-auto max-w-[1400px] text-xs uppercase tracking-widest text-mist">Products</p>
      </div>
      <div class="border-t border-line px-6 pb-24 pt-10 md:px-10 md:pb-32">
        <ul class="mx-auto grid max-w-[1400px] grid-cols-1 gap-6 lg:grid-cols-3">
          {
            products.map((p) => (
              <li class="flex flex-col rounded-2xl border border-line bg-ink-soft p-6 md:p-8">
                <div class="flex items-center justify-between gap-4">
                  <div class="flex items-center gap-4">
                    <img src={p.icon} alt="" width="48" height="48" loading="lazy" decoding="async" class="h-12 w-12 shrink-0" />
                    <h2 class="font-display text-2xl font-black md:text-3xl">{p.name}</h2>
                  </div>
                  <a href={`/project/${p.slug}/`} data-cursor="View" class="shrink-0 py-2 text-sm text-mist transition-colors hover:text-paper">
                    Details →
                  </a>
                </div>
                <p class="mt-5 text-mist">{p.line}</p>
                <div class="mt-auto flex flex-wrap gap-3 pt-8">
                  {p.actions.map((a, i) => (
                    <a href={a.url} target="_blank" rel="noopener noreferrer" data-cursor="Open" class={i === 0 ? BTN_PRIMARY : BTN_SECONDARY}>
                      {a.label} <span aria-hidden="true">→</span>
                    </a>
                  ))}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- WORK -->
    <div id="work" class="px-6 pb-6 md:px-10">
      <p class="mx-auto max-w-[1400px] text-xs uppercase tracking-widest text-mist">Work</p>
    </div>

    <!-- PILLAR SECTIONS -->
    {
      pillars.map((pillar) => {
        const [featured, ...rest] = cardsFor(pillar); // large card + up to 2
        return (
          <section id={pillar.id} class="border-t border-line px-6 py-28 md:px-10 md:py-40">
            <div class="mx-auto max-w-[1400px]">
              <div class="reveal mb-16 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
                <h2 class="font-display text-6xl font-black md:text-8xl">{pillar.label}</h2>
                <p class="text-mist md:text-right">{pillar.tagline}</p>
              </div>
              {
                featured ? (
                  <div class="space-y-16">
                    <ProjectCard
                      featured
                      href={hrefFor(featured)}
                      title={featured.data.title}
                      cover={featured.data.coverLarge ?? featured.data.cover}
                      year={featured.data.year}
                    />
                    {rest.length > 0 && (
                      <div class="grid grid-cols-1 gap-x-10 gap-y-16 lg:grid-cols-2">
                        {rest.map((p) => (
                          <ProjectCard
                            href={hrefFor(p)}
                            title={p.data.title}
                            cover={p.data.cover}
                            year={p.data.year}
                          />
                        ))}
                      </div>
                    )}
                  </div>
                ) : (
                  <p class="reveal text-mist">More coming soon.</p>
                )
              }
              {featured && (
                <a
                  href={`/works/?f=${pillar.id}`}
                  data-cursor="View"
                  class="reveal group mt-16 inline-flex items-center gap-3 font-display text-lg font-bold transition-colors hover:text-accent"
                >
                  View all work
                  <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                </a>
              )}
            </div>
          </section>
        );
      })
    }

    <!-- Inline Ask AI prompt — opens the same side panel via [data-ask-ai] -->
    <section class="border-t border-line px-6 py-28 md:px-10 md:py-40">
      <div class="mx-auto max-w-[1400px]">
        <div class="reveal mb-10">
          <h2 class="font-display text-5xl font-black md:text-7xl">AI Ask</h2>
          <p class="mt-4 max-w-xl text-mist">
            Curious about a project, the process, or working together? Ask the AI — it knows the work.
          </p>
        </div>
        <button
          data-ask-ai
          data-cursor="Ask"
          class="reveal group flex w-full max-w-2xl items-center justify-between gap-4 rounded-full border border-line bg-surface px-6 py-4 text-left transition-colors hover:border-accent"
        >
          <span class="text-base text-mist md:text-lg">Ask me anything…</span>
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-paper font-display text-lg text-ink transition-transform duration-300 group-hover:translate-x-0.5"
          >
            →
          </span>
        </button>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
