---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import aboutHtml from '../../migrated/about.html?raw';
// v3 (2026-10-08): the line under the title decodes the name. It sits outside the article on
// purpose: the about text — and the AI prompt built from it — stay word for word as they were.
---

<Layout
  title="About — zosc"
  description="About zosc — a motion designer, visual artist & developer. 10+ years building OS-level motion systems for vivo and JMGO across code, motion, and visual art."
>

  <main class="pt-36 md:pt-44">
    <section class="px-6 md:px-10">
      <div class="mx-auto max-w-3xl">
        <h1 class="font-display text-6xl font-black md:text-7xl">About</h1>
        <p class="mt-6 text-sm text-mist">zosc — z · oscillator. The clock behind the motion.</p>
        <article class="entry-content mt-12 pb-24" set:html={aboutHtml} />
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  .entry-content { font-size: 1.05rem; line-height: 1.9; color: #d4d4d8; }
  .entry-content > * { margin-block: 1.2rem; }
  .entry-content .lead { font-size: 1.35rem; line-height: 1.7; color: var(--color-paper); }
  .entry-content h2, .entry-content h3 {
    font-family: var(--font-display);
    color: var(--color-paper);
    margin-top: 2.4rem;
  }
  .entry-content h2 { font-size: 1.8rem; }
  .entry-content h3 { font-size: 1.3rem; }
  .entry-content a { color: var(--color-accent-soft); text-decoration: underline; text-underline-offset: 3px; }
  .entry-content ul { padding-left: 1.2rem; list-style: disc; }
  .entry-content li { margin-block: 0.4rem; }
  .entry-content img, .entry-content video { width: 100%; height: auto; border-radius: 14px; }
  .entry-content .contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    font-size: 0.95rem;
  }
  .entry-content .contact-list strong {
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: #a1a1aa;
    margin-right: 0.5rem;
  }
  .entry-content hr { border: 0; border-top: 1px solid #ffffff1a; }
</style>
