---
// v3-G (2026-10-08): a homepage card's direct links — where you get the product (directLinks in
// pages/index.astro) — as one quiet row right under the card. It sits OUTSIDE the card's <a>: a
// link can't contain a link, and the card's own hover (veil lift, zoom, title colour) stays as is.
// 2026-10-09 (user: "看起来不像按钮"): now small pills in the hero's secondary-button language —
// rounded-full, border-line, paper text, accent border/text on hover — one size down (px-4 py-2,
// text-xs) so they read as buttons without competing with the hero's accent button. Nothing here
// moves: the row fades in with its card's reveal, opacity only (global.css .card-links; AGENTS.md:
// a link that moves between mousedown and mouseup loses the click). py-2 = a taller hit area for
// the trailing custom cursor; with mt-1 the link text box starts 12 px below the card's bottom edge
// (a small card's title row, the large card's image). The large card passes px-5: its title is
// inset 20 px on the image, and the row lines up under it. The explicit {' '} before the arrow: inside this
// nested map Astro drops the plain space (it rendered "Adobe Exchange↗"). No links → nothing.
interface Props {
  links: { label: string; url: string }[];
  class?: string; // extra classes (the large card: px-5)
}
const { links, class: className } = Astro.props;
---

{
  links.length > 0 && (
    <p class:list={['card-links mt-3 flex flex-wrap items-center gap-2', className]}>
      {links.map((l) => (
        <a href={l.url} target="_blank" rel="noopener noreferrer" data-cursor="Open" class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border border-line px-4 py-2 font-display text-xs font-bold uppercase tracking-wide text-paper transition-colors hover:border-accent hover:text-accent">
          {l.label}{' '}<span aria-hidden="true">↗</span>
        </a>
      ))}
    </p>
  )
}
